# set powerinit

[Unit]
Description=set powerinit
DefaultDependencies=no
Before=shutdown.target
Conflicts=shutdown.target
After=hobot-mount.service hobot-loadko.service
Wants=hobot-mount.service hobot-loadko.service

[Service]
Type=oneshot
ExecStart=/usr/bin/hobot-powerinit.sh
RemainAfterExit=yes

[Install]
WantedBy=sysinit.target
