[Unit]
Description=QEMU Guest Agent
DefaultDependencies=no
After=hobot-mount.service hobot-loadko.service
Wants=hobot-mount.service hobot-loadko.service

[Service]
Type=simple
ExecStart=/usr/sbin/qemu-ga -v -m unix-listen -p /var/lib/qga
Restart=always
RestartSec=1
TimeoutStopSec=10s

[Install]
WantedBy=basic.target
