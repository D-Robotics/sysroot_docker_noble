prefix=/usr
exec_prefix=${prefix}
libdir=${prefix}/lib/aarch64-linux-gnu
includedir=${prefix}/include

Name: cfitsio
Description: FITS File Subroutine Library
URL: https://heasarc.gsfc.nasa.gov/fitsio/
Version: 4.3.1
Libs: -L${libdir} -lcfitsio
Libs.private: -lcurl -lpthread -lz -lbz2  -lm
Cflags: -I${includedir}
