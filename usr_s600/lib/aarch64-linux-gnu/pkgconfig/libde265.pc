prefix=/usr
exec_prefix=${prefix}
libdir=${prefix}/lib/aarch64-linux-gnu
includedir=${prefix}/include

Name: libde265
Description: H.265/HEVC video decoder.
URL: https://github.com/strukturag/libde265
Version: 1.0.15
Requires:
Libs: -lde265 -L${libdir}
Libs.private: -lm  -lstdc++
Cflags: -I${includedir}
