# Package Information for pkg-config

prefix=/usr
exec_prefix=${prefix}
libdir=${prefix}/lib/aarch64-linux-gnu
includedir=${prefix}/include

Name: freexl
Description: a simple library extracting data from .xls (Excel BIFF) files
Version: 2.0.0
Libs: -L${libdir} -lfreexl -lm
Cflags: -I${includedir} 
