prefix=/usr
exec_prefix=${prefix}
libdir=${exec_prefix}/lib/aarch64-linux-gnu
includedir=${prefix}/include/suitesparse

Name: ParU
URL: https://github.com/DrTimothyAldenDavis/SuiteSparse
Description: Routines for solving sparse linear system via parallel multifrontal LU factorization algorithms in SuiteSparse
Version: 0.1.2
Requires.private: SuiteSparse_config UMFPACK
Libs: -L${libdir} -lparu
Libs.private:  -lgomp -lpthread -lm -lblas
Cflags: -I${includedir}
