prefix=/usr
exec_prefix=${prefix}
libdir=${exec_prefix}/lib/aarch64-linux-gnu
includedir=${prefix}/include/suitesparse

Name: SPEX
URL: https://github.com/DrTimothyAldenDavis/SuiteSparse
Description: Software package for SParse EXact algebra in SuiteSparse
Version: 2.3.2
Requires.private: SuiteSparse_config AMD COLAMD
Libs: -L${libdir} -lspex
Libs.private:  -lmpfr -lgmp -lm
Cflags: -I${includedir}
